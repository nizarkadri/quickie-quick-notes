<Application x:Class="StickyNotes.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="BarBackground" Color="#E8202020" />
        <SolidColorBrush x:Key="PillIdle" Color="#38888888" />
        <SolidColorBrush x:Key="PillHover" Color="#80888888" />
        <SolidColorBrush x:Key="TextPrimary" Color="#DFFFFFFF" />

        <!-- F4: dark bubble for note previews (and every other tooltip). Light text on the
             WPF default light tooltip background was unreadable; keep the chrome dark. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F22A2A2A" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="#DFFFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="4"
                                                  Direction="270"
                                                  Color="Black"
                                                  Opacity="0.45" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
