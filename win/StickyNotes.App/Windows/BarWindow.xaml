<Window x:Class="StickyNotes.App.Windows.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="1100"
        Height="44"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="Root"
            CornerRadius="8"
            Background="{StaticResource BarBackground}"
            BorderBrush="#30FFFFFF"
            BorderThickness="1,0,1,1">
        <Grid>
            <!-- 3-column layout keeps the '+' geometrically pinned to monitor center (blueprint §2.3). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: pinned items rail (populated in Task 6). -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0">
                <StackPanel x:Name="PinnedPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center" />
            </ScrollViewer>

            <!-- Center: dead-center '+' quick-note capture. -->
            <Button x:Name="PlusButton"
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    FontSize="22"
                    Content="+"
                    Foreground="{StaticResource TextPrimary}"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnPlusClick" />

            <!-- Right: recents (populated in Task 6). -->
            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0">
                <StackPanel x:Name="RecentPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
