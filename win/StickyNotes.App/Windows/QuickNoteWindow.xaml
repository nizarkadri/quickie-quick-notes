<Window x:Class="StickyNotes.App.Windows.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="380"
        Height="220"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="Root"
            CornerRadius="8"
            Background="{StaticResource BarBackground}"
            BorderBrush="#30FFFFFF"
            BorderThickness="1">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />    <!-- close (×) row -->
                <RowDefinition Height="*" />      <!-- text -->
                <RowDefinition Height="Auto" />   <!-- target selector + hint -->
            </Grid.RowDefinitions>

            <Button x:Name="CloseButton"
                    Grid.Row="0"
                    HorizontalAlignment="Right"
                    Width="20"
                    Height="20"
                    Padding="0"
                    Content="×"
                    FontSize="14"
                    ToolTip="Discard"
                    Foreground="#B0FFFFFF"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnCloseButtonClick" />

            <TextBox x:Name="BodyBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     FontSize="14"
                     Foreground="{StaticResource TextPrimary}"
                     Background="Transparent"
                     BorderThickness="0"
                     CaretBrush="{StaticResource TextPrimary}"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="OnBodyPreviewKeyDown" />

            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StandaloneButton"
                            Height="26"
                            Padding="10,0"
                            Content="Standalone"
                            FontSize="11"
                            Foreground="{StaticResource TextPrimary}"
                            Background="#3A3A3A"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnStandaloneClick" />
                    <Button x:Name="GroupButton"
                            Height="26"
                            Margin="6,0,0,0"
                            Padding="10,0"
                            Content="Group ▾"
                            FontSize="11"
                            Foreground="{StaticResource TextPrimary}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnGroupClick" />
                    <Button x:Name="AppendButton"
                            Height="26"
                            Margin="6,0,0,0"
                            Padding="10,0"
                            Content="Append to ▾"
                            FontSize="11"
                            Foreground="{StaticResource TextPrimary}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnAppendClick" />
                </StackPanel>
                <TextBlock Text="Ctrl+Enter or click outside to save · Esc to discard"
                           Foreground="#80FFFFFF"
                           FontSize="10"
                           Margin="2,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
