<Window x:Class="StickyNotes.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickyNotes Settings"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        Topmost="True"
        Background="{StaticResource BarBackground}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Notes location -->
        <TextBlock Grid.Row="0"
                   Text="Notes are saved in:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />

        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox"
                     Grid.Column="0"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     Padding="6,4"
                     Background="#30000000"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="#40FFFFFF"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Content="Browse…"
                    Cursor="Hand"
                    Click="OnBrowseClick" />
        </Grid>

        <!-- Path that will actually hold the database (informational) -->
        <TextBlock x:Name="DbPathHint"
                   Grid.Row="2"
                   Foreground="#9FFFFFFF"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <!-- Auto start -->
        <CheckBox x:Name="StartupCheck"
                  Grid.Row="3"
                  Content="Start StickyNotes when I log in"
                  Foreground="{StaticResource TextPrimary}"
                  Margin="0,0,0,14" />

        <!-- Restart hint for folder changes -->
        <TextBlock Grid.Row="4"
                   Foreground="#9FFFFFFF"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Text="Folder changes take effect after you restart StickyNotes. Existing notes are moved into the new folder."
                   Margin="0,0,0,16" />

        <!-- Actions -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    Content="Save"
                    IsDefault="True"
                    Cursor="Hand"
                    Click="OnSaveClick" />
            <Button x:Name="CancelButton"
                    Padding="16,6"
                    Content="Cancel"
                    Cursor="Hand"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>