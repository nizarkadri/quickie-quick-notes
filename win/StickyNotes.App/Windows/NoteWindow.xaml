<Window x:Class="StickyNotes.App.Windows.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="320"
        Height="280"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="Root"
            CornerRadius="8"
            Background="{StaticResource BarBackground}"
            BorderBrush="#30FFFFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- header / delete-confirm -->
                <RowDefinition Height="Auto" />   <!-- F1: inline new-group row -->
                <RowDefinition Height="*" />      <!-- body -->
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderPanel" Grid.Row="0" Height="32" Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- pin -->
                    <ColumnDefinition Width="*" />     <!-- group badge -->
                    <ColumnDefinition Width="Auto" />  <!-- delete -->
                    <ColumnDefinition Width="Auto" />  <!-- close -->
                </Grid.ColumnDefinitions>
                <Button x:Name="PinToggleButton"
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Content="📌"
                        FontSize="12"
                        ToolTip="Pin / unpin note"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnPinToggleClick" />
                <Button x:Name="GroupBadge"
                        Grid.Column="1"
                        Height="28"
                        Padding="6,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#9CDCFE"
                        FontSize="11"
                        Cursor="Hand"
                        ToolTip="Move to group"
                        Click="OnMoveToGroupClick" />
                <Button x:Name="DeleteButton"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Content="🗑"
                        FontSize="12"
                        ToolTip="Delete note"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnDeleteClick" />
                <Button x:Name="CloseButton"
                        Grid.Column="3"
                        Width="28"
                        Height="28"
                        Content="×"
                        FontSize="16"
                        Foreground="{StaticResource TextPrimary}"
                        ToolTip="Close (autosaves)"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCloseClick" />
            </Grid>

            <!-- Inline delete confirmation — never a modal dialog. -->
            <Grid x:Name="ConfirmPanel" Grid.Row="0" Height="32" Margin="4,0,4,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Delete note?"
                           Grid.Column="0"
                           Foreground="#FFB0B0"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <Button x:Name="ConfirmDeleteButton"
                        Grid.Column="1"
                        Height="22"
                        Padding="8,0"
                        Content="Delete"
                        FontSize="11"
                        Foreground="White"
                        Background="#A04040"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnConfirmDeleteClick" />
                <Button x:Name="ConfirmCancelButton"
                        Grid.Column="2"
                        Height="22"
                        Padding="8,0"
                        Margin="4,0,0,0"
                        Content="Cancel"
                        FontSize="11"
                        Foreground="{StaticResource TextPrimary}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnConfirmCancelClick" />
            </Grid>

            <!-- F1: inline new-group row — shown when "＋ New group…" is picked from the move menu. -->
            <Grid x:Name="NewGroupPanel" Grid.Row="1" Height="32" Margin="6,0,6,2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewGroupBox"
                         Grid.Column="0"
                         FontSize="12"
                         Foreground="{StaticResource TextPrimary}"
                         Background="#22FFFFFF"
                         BorderThickness="0"
                         CaretBrush="{StaticResource TextPrimary}"
                         Padding="4,3"
                         VerticalContentAlignment="Center"
                         KeyDown="OnNewGroupKeyDown" />
                <Button x:Name="CreateGroupButton"
                        Grid.Column="1"
                        Height="24"
                        Padding="8,0"
                        Margin="4,0,0,0"
                        Content="Create"
                        FontSize="11"
                        Foreground="White"
                        Background="#3C6E3C"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCreateGroupClick" />
                <Button x:Name="CancelNewGroupButton"
                        Grid.Column="2"
                        Height="24"
                        Padding="8,0"
                        Margin="4,0,0,0"
                        Content="Cancel"
                        FontSize="11"
                        Foreground="{StaticResource TextPrimary}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCancelNewGroupClick" />
            </Grid>

            <TextBox x:Name="BodyBox"
                     Grid.Row="2"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="{StaticResource TextPrimary}"
                     Background="Transparent"
                     BorderThickness="0"
                     CaretBrush="{StaticResource TextPrimary}"
                     Padding="8,6"
                     VerticalScrollBarVisibility="Auto"
                     KeyDown="OnBodyKeyDown"
                     TextChanged="OnBodyTextChanged" />
        </Grid>
    </Border>
</Window>
