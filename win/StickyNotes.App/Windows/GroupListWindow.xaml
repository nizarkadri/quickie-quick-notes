<Window x:Class="StickyNotes.App.Windows.GroupListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="260"
        SizeToContent="Height"
        MaxHeight="420"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="Root"
            CornerRadius="8"
            Background="{StaticResource BarBackground}"
            BorderBrush="#30FFFFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- header / confirm header -->
                <RowDefinition Height="Auto" />   <!-- inline edit row -->
                <RowDefinition Height="Auto" />   <!-- + New Note (OpenGroup only) -->
                <RowDefinition Height="*" />      <!-- scrollable rows -->
            </Grid.RowDefinitions>

            <!-- Normal header (OpenGroup: name + pin/rename/delete · OpenAllGroups: title + new group button) -->
            <Grid x:Name="HeaderPanel" Grid.Row="0" Height="36" Margin="6,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />   <!-- close -->
                </Grid.ColumnDefinitions>
                <Button x:Name="NewGroupButton"
                        Grid.Column="1"
                        Height="24"
                        Padding="8,0"
                        Content="＋ New Group"
                        FontSize="11"
                        Foreground="#9CDCFE"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnNewGroupClick"
                        Visibility="Collapsed" />
                <TextBlock x:Name="HeaderTitle"
                           Grid.Column="0"
                           Text="Groups"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="PinToggleButton"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Content="📌"
                        FontSize="13"
                        ToolTip="Pin / unpin group"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnPinToggleClick" />
                <Button x:Name="RenameButton"
                        Grid.Column="3"
                        Width="28"
                        Height="28"
                        Content="✎"
                        FontSize="14"
                        Foreground="{StaticResource TextPrimary}"
                        ToolTip="Rename group"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnRenameClick" />
                <Button x:Name="DeleteButton"
                        Grid.Column="4"
                        Width="28"
                        Height="28"
                        Content="🗑"
                        FontSize="13"
                        ToolTip="Delete group"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnDeleteClick" />
                <Button x:Name="CloseButton"
                        Grid.Column="5"
                        Width="28"
                        Height="28"
                        Content="×"
                        FontSize="16"
                        Foreground="{StaticResource TextPrimary}"
                        ToolTip="Close"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCloseButtonClick" />
            </Grid>

            <!-- Inline delete confirmation — swaps over the header; NEVER a modal dialog. -->
            <Grid x:Name="ConfirmPanel" Grid.Row="0" Height="36" Margin="6,0,6,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ConfirmText"
                           Grid.Column="0"
                           Foreground="#FFB0B0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="ConfirmDeleteButton"
                        Grid.Column="1"
                        Height="24"
                        Padding="8,0"
                        Content="Delete"
                        FontSize="11"
                        Foreground="White"
                        Background="#A04040"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnConfirmDeleteClick" />
                <Button x:Name="ConfirmCancelButton"
                        Grid.Column="2"
                        Height="24"
                        Padding="8,0"
                        Margin="4,0,0,0"
                        Content="Cancel"
                        FontSize="11"
                        Foreground="{StaticResource TextPrimary}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnConfirmCancelClick" />
            </Grid>

            <!-- Inline edit row (rename / new group). Hidden until BeginInlineEdit. -->
            <Border x:Name="EditHost" Grid.Row="1" Visibility="Collapsed" Margin="6,2,6,2">
                <TextBox x:Name="EditBox"
                         FontSize="13"
                         Foreground="{StaticResource TextPrimary}"
                         Background="#22FFFFFF"
                         BorderThickness="0"
                         CaretBrush="{StaticResource TextPrimary}"
                         Padding="4,3"
                         KeyDown="OnEditBoxKeyDown" />
            </Border>

            <!-- Permanent '+ New Note' row (OpenGroup mode only). -->
            <Button x:Name="NewNoteButton"
                    Grid.Row="2"
                    Height="32"
                    HorizontalContentAlignment="Left"
                    Padding="10,0"
                    Content="＋  New Note"
                    FontSize="13"
                    Foreground="#9CDCFE"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnNewNoteClick" />

            <!-- Scrollable rows: note rows (OpenGroup) or group rows + '+ New Group' (OpenAllGroups). -->
            <ScrollViewer x:Name="RowsScroll"
                          Grid.Row="3"
                          MaxHeight="340"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RowsPanel" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
