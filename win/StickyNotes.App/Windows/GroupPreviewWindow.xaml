<Window x:Class="StickyNotes.App.Windows.GroupPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="240"
        Height="420"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border CornerRadius="8"
            Background="{StaticResource BarBackground}"
            BorderBrush="#30FFFFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- group name -->
                <RowDefinition Height="*" />      <!-- scrollable note rows -->
            </Grid.RowDefinitions>

            <TextBlock x:Name="GroupTitle"
                       Grid.Row="0"
                       Margin="10,8,10,4"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <ScrollViewer x:Name="RowsScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RowsPanel" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
